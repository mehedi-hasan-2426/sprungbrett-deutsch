{
  "name": "sprungbrett-deutsch",
  "version": "0.1.0",
  "private": true,
  "description": "Sprungbrett: a privacy-first German A1 to A2 practice app with instant feedback",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "content": "node --experimental-strip-types --no-warnings scripts/build-content.ts",
    "predev": "npm run content",
    "dev": "next dev --webpack",
    "start": "next start --hostname 127.0.0.1",
    "prebuild": "npm run content",
    "build": "next build --webpack",
    "postbuild": "node scripts/check-output.mjs",
    "lint": "eslint .",
    "typecheck": "npm run content && tsc --noEmit",
    "pretest": "npm run content",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/**/*.test.ts\" \"tests/**/*.test.mjs\"",
    "verify": "node scripts/verify.mjs",
    "verify:negative": "node scripts/verify-negative.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
